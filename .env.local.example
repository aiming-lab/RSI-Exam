# Copy to `.env.local` (git-ignored) and fill in what you need:
#
#   set -a; source .env.local; set +a          # then `harbor run ...` as usual
#
# Of the 35 public tasks, only FOUR call a model from inside the task itself — as a
# judge, or as the frozen base model the agent is optimising around. Everything else
# needs nothing here.
#
# Each key reaches ONLY the task that declares it in [environment.env]: harbor's
# resolve_env_vars passes through the names a task asks for and nothing else, so one
# superset file is safe. Least privilege matters here — a stray key is a cheat vector
# on tasks whose base model is pinned.
#
# Every task takes an API_KEY plus an OpenAI-compatible API_BASE, so it runs against
# whatever provider you have (OpenAI / Azure / a gateway). MODEL is pinned by the task:
# overriding it invalidates that task's anchors. Set it only if your provider names the
# same model differently (an Azure deployment name, say).
#
# ⚠ harbor tests `if var_name in os.environ` — presence, not value. An empty assignment
#   yields an empty string in the container, NOT the default. Comment the line out to
#   fall back to the default.
#
# ⚠ Never name a run-wide key `OPENAI_API_KEY`: the codex adapter uploads that one
#   wholesale into the agent container. The per-task names below avoid it by design.

# ── locomo_longterm_memory ─────────────────────────────────────────────────
# The memory system being optimised runs on a frozen base model.
MEMORY_LLM_API_KEY=
# MEMORY_LLM_API_BASE=https://api.openai.com/v1     # default
# MEMORY_LLM_MODEL=gpt-4o-mini                      # pinned by the task

# ── legal_matter_caseload_regulatory ───────────────────────────────────────
# A rubric judge scores the submitted casework.
APEX_LLM_API_KEY=
# APEX_LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai   # default
# APEX_JUDGE_MODEL=gemini-3-flash-preview           # pinned by the task
# APEX_JUDGE_EFFORT=low
# APEX_JUDGE_MAX_TOKENS=512
# APEX_JUDGE_SAMPLES=1

# ── lean_formal_proof_workflow_design ──────────────────────────────────────
# The proof model the agent's workflow drives.
LEAN_LLM_API_KEY=
# LEAN_LLM_API_BASE=https://api.openai.com/v1       # default

# ── discoveryworld_agent_harness_low2 ──────────────────────────────────────
# The frozen model the harness under optimisation drives.
DISCOVERYWORLD_LLM_API_KEY=
# DISCOVERYWORLD_LLM_API_BASE=https://api.openai.com/v1   # default
# DISCOVERYWORLD_LLM_MODEL=gpt-4o                   # pinned by the task
